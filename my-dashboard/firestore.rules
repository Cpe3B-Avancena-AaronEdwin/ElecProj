rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() && userDoc().data != null;
    }

    function role() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return userExists() && role() == "admin";
    }

    function isOperator() {
      return userExists() && role() == "operator";
    }

    function isViewer() {
      return userExists() && role() == "viewer";
    }

    function isAdminOrOperator() {
      return isAdmin() || isOperator();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userAllowedKeys() {
      return [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "role",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ];
    }

    function ownerEditableKeys() {
      return [
        "displayName",
        "photoURL",
        "updatedAt",
        "lastLoginAt"
      ];
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(userAllowedKeys());

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userAllowedKeys())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["admin", "operator", "viewer"];

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(userAllowedKeys());

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(ownerEditableKeys())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // ROUTES
    match /routes/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // STOPS
    match /stops/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // VEHICLES
    match /vehicles/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // TRIPS
    match /trips/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // TRAFFIC SNAPSHOTS
    match /trafficSnapshots/{snapshotId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // PREDICTIONS
    match /predictions/{predictionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrOperator();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}